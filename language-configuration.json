{
	"comments": {
		"lineComment": ";"
	},
	"brackets": [
		["(", ")"]
	],
	"autoClosingPairs": [
		{ "open": "(", "close": ")" },
		{ "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
		{ "open": "'", "close": "'", "notIn": ["string", "comment"] }
	],
	"wordPattern": "[A-Za-z_?@][\\w?@]*|#?[0-9][0-9A-Za-z]*"
}
